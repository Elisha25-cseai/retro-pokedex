<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pokémon Cards</title>
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

  <h1 class="title">Pokémon Cards</h1>

  <% if (locals.data) { %>
    <div class="grid">
      <% for (let i = 0; i < data.length; i++) { %>
        <div class="card">
          <img src="<%= data[i].image %>" alt="<%= data[i].name %>">
          <h3><%= data[i].name %></h3>
          <p><strong>Type:</strong> <%= data[i].type %></p>
          <p><strong>Health:</strong> <%= data[i].health %></p>
          <p><strong>Power:</strong> <%= data[i].power %></p>
          <p><strong>Defense:</strong> <%= data[i].defense %></p>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (locals.error) { %>
    <p class="error"><%= error %></p>
  <% } %>

</body>
</html>
